# ─── AuthFleet ─────────────────────────────────────────
# Copy to .env.local, fill in, restart. Defaults below work on localhost
# but keep every value present so prod deploys don't boot without one set.

# Login password for the operator (min 4 chars). Dev fallback: "authfleet-dev".
AUTHFLEET_PASSWORD=change-me

# AES-256-GCM key for OAuth client secrets + Gmail refresh tokens (32 bytes).
# Leave blank on dev — the app seeds data/encrypt.key automatically.
# Production: generate with `openssl rand -base64 32`.
AUTHFLEET_ENCRYPT_KEY=

# HS256 signing key for session JWTs (32 bytes). Same rule as encrypt key.
AUTHFLEET_SESSION_KEY=

# Next dev server port (3000 by default).
PORT=3000
